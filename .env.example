# Cloudflare → R2 → Manage API tokens (Object Read & Write, solo el bucket wallflow-community)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wallflow-community
# URL pública del bucket (r2.dev por ahora; luego el dominio propio)
PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
